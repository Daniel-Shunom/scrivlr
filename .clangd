CompileFlags:
  CompilationDatabase: build/gcc16/debug
  # GCC module/dependency flags are not understood by clangd's Clang parser.
  Remove: [-fmodules-ts, -freflection, -fdeps-format=*, -fmodule-mapper=*]
---
If:
  PathMatch: .*[.](cpp|cppm|cc|cxx|hpp|hxx)
CompileFlags:
  # New files borrow commands before CMake knows about them. clangd can drop
  # language/standard flags while transferring those commands, so set both here.
  # Keep these together: clangd's module scanner may also reuse this configuration
  # for C dependencies, which would reject -std=c++26 without the language override.
  # Include paths are relative to build/gcc16/debug (the compilation directory).
  Add:
    - -xc++
    - -std=c++26
    # Editor-only Clay overlay exposes initializer types for property completion.
    - -DSCRIVLR_CLANGD=1
    - -I../../../tools/clangd
    # A newly created file can borrow a C dependency's command, which lacks Clay.
    - -I../../../vendor
    - --target=x86_64-w64-windows-gnu
    - -isystem
    - ../../../.tools/gcc16/mingw64/include/c++/16.2.0
    - -isystem
    - ../../../.tools/gcc16/mingw64/include/c++/16.2.0/x86_64-w64-mingw32
    - -isystem
    - ../../../.tools/gcc16/mingw64/include/c++/16.2.0/backward
    - -isystem
    - ../../../.tools/gcc16/mingw64/x86_64-w64-mingw32/include
---
If:
  PathMatch: src/(main[.]cpp|scrivlr_lib[.]cppm|components/registry/component_registry[.]cppm)
Diagnostics:
  # Stock clangd cannot parse GCC's C++26 reflection; GCC remains the checker.
  Suppress:
    - no_member
    - nonfunction_block_type
    - expected_expression
    - blocks_disable
    - typename_requires_specqual
